+int entropy_blake2s_renewal_snapshot(struct entropy_blake2s_renewal_stats *out)
+{
+	int err;
+
+	if (out == NULL) {
+		return -EINVAL;
+	}
+	if (!blake2s_data.initialized) {
+		return -ENODEV;
+	}
+
+	err = k_mutex_lock(&blake2s_data.lock, K_FOREVER);
+	if (err != 0) {
+		return err;
+	}
+
+	out->timestamp_us = k_ticks_to_us_floor64(k_uptime_ticks());
+	out->total_hw_bytes = blake2s_data.total_hw_bytes;
+	out->total_external_bytes = blake2s_data.total_external_bytes;
+	out->total_extracted_bytes = blake2s_data.total_extracted_bytes;
+	out->total_pool_debit_bytes = blake2s_data.total_pool_debit_bytes;
+	out->total_thread_get_bytes = blake2s_data.total_thread_get_bytes;
+	out->total_isr_get_bytes = blake2s_data.total_isr_get_bytes;
+	out->total_fast_refill_bytes = blake2s_data.total_fast_refill_bytes;
+	out->hw_refill_count = blake2s_data.hw_refill_count;
+	out->extract_count = blake2s_data.extract_count;
+	out->external_add_count = blake2s_data.external_add_count;
+	out->isr_busywait_count = blake2s_data.isr_busywait_count;
+	out->credited_pool_bits = blake2s_data.pool.init_bits;
+	out->credited_pool_bytes = blake2s_data.pool.init_bits / 8;
+	out->fast_buffer_avail = blake2s_data.fast_buffer_avail;
+	out->hw_refill_enabled = blake2s_data.hw_refill_enabled;
+	out->refilling = blake2s_data.refilling;
+
+	k_mutex_unlock(&blake2s_data.lock);
+	return 0;
+}
+
+void entropy_blake2s_renewal_reset_counters(void)
+{
+	if (!blake2s_data.initialized) {
+		return;
+	}
+
+	if (k_mutex_lock(&blake2s_data.lock, K_FOREVER) != 0) {
+		return;
+	}
+	blake2s_data.hw_refill_count = 0;
+	blake2s_data.extract_count = 0;
+	blake2s_data.external_add_count = 0;
+	blake2s_data.isr_busywait_count = 0;
+	blake2s_data.total_hw_bytes = 0;
+	blake2s_data.total_external_bytes = 0;
+	blake2s_data.total_extracted_bytes = 0;
+	blake2s_data.total_pool_debit_bytes = 0;
+	blake2s_data.total_thread_get_bytes = 0;
+	blake2s_data.total_isr_get_bytes = 0;
+	blake2s_data.total_fast_refill_bytes = 0;
+	k_mutex_unlock(&blake2s_data.lock);
+}
+
+void entropy_blake2s_renewal_set_hw_refill_enabled(bool enabled)
+{
+	if (!blake2s_data.initialized) {
+		return;
+	}
+	if (k_mutex_lock(&blake2s_data.lock, K_FOREVER) != 0) {
+		return;
+	}
+	blake2s_data.hw_refill_enabled = enabled;
+	if (!enabled) {
+		blake2s_data.refilling = false;
+	}
+	k_mutex_unlock(&blake2s_data.lock);
+}
+
 /*
  * Device instantiation
  */
diff --git a/include/zephyr/drivers/entropy_blake2s_renewal.h b/include/zephyr/drivers/entropy_blake2s_renewal.h
new file mode 100644
index 0000000000..3333333333
--- /dev/null
+++ b/include/zephyr/drivers/entropy_blake2s_renewal.h
@@ -0,0 +1,47 @@
+/*
+ * Instrumentation API for the BLAKE2s entropy-pool renewal benchmark.
+ *
+ * This header is intentionally separate from the generic Zephyr entropy API.
+ * It exposes implementation counters from the experimental BLAKE2s pool only.
+ */
+
+#ifndef ZEPHYR_INCLUDE_DRIVERS_ENTROPY_BLAKE2S_RENEWAL_H_
+#define ZEPHYR_INCLUDE_DRIVERS_ENTROPY_BLAKE2S_RENEWAL_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct entropy_blake2s_renewal_stats {
+	uint64_t timestamp_us;
+	uint64_t total_hw_bytes;
+	uint64_t total_external_bytes;
+	uint64_t total_extracted_bytes;
+	uint64_t total_pool_debit_bytes;
+	uint64_t total_thread_get_bytes;
+	uint64_t total_isr_get_bytes;
+	uint64_t total_fast_refill_bytes;
+	uint32_t hw_refill_count;
+	uint32_t extract_count;
+	uint32_t external_add_count;
+	uint32_t isr_busywait_count;
+	uint32_t credited_pool_bits;
+	uint32_t credited_pool_bytes;
+	uint8_t fast_buffer_avail;
+	bool hw_refill_enabled;
+	bool refilling;
+};
+
+int entropy_blake2s_renewal_snapshot(
+	struct entropy_blake2s_renewal_stats *out);
+void entropy_blake2s_renewal_reset_counters(void);
+void entropy_blake2s_renewal_set_hw_refill_enabled(bool enabled);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_DRIVERS_ENTROPY_BLAKE2S_RENEWAL_H_ */
